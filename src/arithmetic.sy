// Use defined int32 arithmetic inputs; division by zero has an explicit branch.
void emit(int value) {
    putint(value);
    putch(10);
}

int main() {
    int a = getint();
    int b = getint();
    if (b == 0) {
        emit(-1);
        return 0;
    }
    emit(a + b);
    emit(a - b);
    emit(a * b);
    emit(a / b);
    emit(a % b);
    emit(-a);
    emit(+a);
    emit(a < b);
    emit(a <= b);
    emit(a > b);
    emit(a >= b);
    emit(a == b);
    emit(a != b);
    return 0;
}
